# Local development defaults only. Docker Compose overrides the database/Redis hosts.
APP_NAME=AI Pull Request Review Agent
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://review_agent:review_agent@localhost:5432/review_agent
REDIS_URL=redis://localhost:6379/0
HEALTH_CHECK_TIMEOUT_SECONDS=3

# Phase 2 GitHub integration. An empty secret disables the webhook endpoint.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_REQUEST_TIMEOUT_SECONDS=15
GITHUB_MAX_ATTEMPTS=3
GITHUB_MAX_FILE_BYTES=1000000
MAX_WEBHOOK_BODY_BYTES=2000000
WEBHOOK_ENQUEUE_TIMEOUT_SECONDS=3
REVIEW_JOB_TTL_SECONDS=86400
REDIS_OPERATION_TIMEOUT_SECONDS=3
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=30
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=10
WORKER_JOB_TIMEOUT_SECONDS=600
WORKER_SHUTDOWN_GRACE_SECONDS=15
WORKER_MAINTENANCE_BATCH=50
WORKER_DEAD_LETTER_LIMIT=1000
PR_CACHE_TTL_SECONDS=300
PR_CACHE_MAX_BYTES=500000

# Phase 4: defaults run without credentials or paid API calls.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_MOCK_MODE=true
LLM_OUTPUT_MODE=json_schema
LLM_REQUEST_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TOKEN_LIMIT_FIELD=max_completion_tokens
MAX_FILES_PER_REVIEW=30
MAX_PATCH_CHARS=60000
AGENT_TIMEOUT_SECONDS=210

# Phase 7: optional revision-scoped repository context. Mock embeddings are lexical.
RETRIEVAL_ENABLED=false
EMBEDDING_MOCK_MODE=true
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=128
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_BATCH_SIZE=16
INDEX_MAX_FILES=100
INDEX_MAX_FILE_BYTES=100000
INDEX_MAX_TOTAL_BYTES=2000000
INDEX_MAX_CHUNKS=1000
INDEX_CHUNK_CHARS=1800
INDEX_TIMEOUT_SECONDS=180
MAX_CONTEXT_CHUNKS=3
MAX_CONTEXT_CHARS=6000
RETRIEVAL_QUERY_CHARS=4000
RETRIEVAL_MIN_SIMILARITY=0.15
RETRIEVAL_TIMEOUT_SECONDS=45

# Phase 5 durable workflow checkpoints use DATABASE_URL in their own schema.
# No separate database URL, model key, or hosted graph service is required.
